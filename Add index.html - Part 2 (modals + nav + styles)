<style>
:root {
  --yellow:   #FBBC04;
  --blue:     #4285F4;
  --pink:     #FF4FCB;
  --orange:   #FF6D00;
  --gray:     #CBD5E1;
  --dark:     #4B5563;
  --black:    #1C1C1E;
  --white:    #FFFFFF;
  --bg:       #FAFAFA;
  --bg-soft:  #F5F5F7;
  --border:   #E5E7EB;
  --radius:   16px;
  --shadow:   0 1px 3px rgba(0,0,0,.05), 0 1px 2px rgba(0,0,0,.03);
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, Arial, sans-serif;
  color: var(--black);
  direction: rtl;
  text-align: right;
  line-height: 1.6;
  min-height: 100vh;
  padding-bottom: 90px;
  font-size: 15px;
}

a { color: var(--blue); text-decoration: none; }
button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
input, textarea, select { font-family: inherit; font-size: 15px; }
img { max-width: 100%; display: block; }

.wrap { max-width: 640px; margin: 0 auto; padding: 0 16px; }

/* ==================== HEADER ==================== */
.app-header {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  padding: 14px 0;
  position: sticky;
  top: 0;
  z-index: 40;
}
.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.logo-box {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  overflow: hidden;
  flex-shrink: 0;
}
.logo-box svg { width: 100%; height: 100%; display: block; }
.brand-title {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--black);
  display: flex;
  align-items: center;
  gap: 8px;
}
.brand-title .ar { font-size: 1.05rem; }

/* ==================== HERO ==================== */
.hero {
  text-align: center;
  padding: 24px 0 16px;
}
.hero h1 {
  font-size: 1.6rem;
  font-weight: 900;
  color: var(--black);
  margin: 0 0 8px;
  line-height: 1.3;
}
.hero p {
  font-size: 0.95rem;
  color: var(--dark);
  margin: 0 0 4px;
}
.hero .slogan {
  display: inline-block;
  background: linear-gradient(135deg, var(--yellow), var(--orange));
  color: var(--white);
  padding: 6px 16px;
  border-radius: 20px;
  font-weight: 700;
  font-size: 0.9rem;
  margin-top: 8px;
}

/* ==================== BUTTONS ==================== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 20px;
  border-radius: 14px;
  font-size: 1rem;
  font-weight: 700;
  transition: transform .08s ease, opacity .2s;
  border: none;
}
.btn:active { transform: scale(.97); }
.btn-primary {
  background: linear-gradient(135deg, var(--blue), #2b6fd9);
  color: var(--white);
  box-shadow: 0 4px 12px rgba(66,133,244,.3);
}
.btn-secondary {
  background: var(--white);
  color: var(--black);
  border: 1.5px solid var(--border);
}
.btn-pink {
  background: linear-gradient(135deg, var(--pink), #e91e8c);
  color: var(--white);
  box-shadow: 0 4px 12px rgba(255,79,203,.3);
}
.btn-block { width: 100%; }
.btn-sm { padding: 10px 14px; font-size: 0.9rem; border-radius: 10px; }

/* ==================== ACTIONS ==================== */
.main-actions {
  display: flex;
  gap: 10px;
  margin: 16px 0;
}
.main-actions .btn { flex: 1; }

/* ==================== STATS ==================== */
.stats {
  display: flex;
  gap: 10px;
  margin: 16px 0;
}
.stat {
  flex: 1;
  background: var(--white);
  border-radius: var(--radius);
  padding: 14px 10px;
  text-align: center;
  box-shadow: var(--shadow);
  border: 1px solid var(--border);
}
.stat .num {
  font-size: 1.5rem;
  font-weight: 900;
  color: var(--blue);
}
.stat .lbl {
  font-size: 0.78rem;
  color: var(--dark);
  margin-top: 2px;
}

/* ==================== KHATERA ==================== */
.khatera {
  background: linear-gradient(135deg, #FFF8E1, #FFECB3);
  border-radius: var(--radius);
  padding: 16px 18px;
  margin: 16px 0;
  border: 1px solid #FFE082;
  position: relative;
}
.khatera .k-label {
  font-size: 0.8rem;
  font-weight: 800;
  color: var(--orange);
  margin-bottom: 6px;
}
.khatera .k-text {
  font-size: 1rem;
  color: var(--black);
  font-weight: 600;
  line-height: 1.6;
}
.khatera .k-link {
  display: inline-block;
  margin-top: 10px;
  color: var(--blue);
  font-weight: 700;
  font-size: 0.9rem;
}

/* ==================== SECTION TITLE ==================== */
.section-title {
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--black);
  margin: 20px 0 10px;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* ==================== SEARCH ==================== */
.search-bar {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}
.search-bar input {
  flex: 1;
  padding: 13px 16px;
  border-radius: 14px;
  border: 1.5px solid var(--border);
  background: var(--white);
  font-size: 15px;
  color: var(--black);
}
.search-bar input:focus { outline: none; border-color: var(--blue); }

/* ==================== FILTERS ==================== */
.filters-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 14px;
  background: var(--white);
  border-radius: 12px;
  border: 1.5px solid var(--border);
  font-weight: 700;
  color: var(--dark);
  margin-bottom: 10px;
}
.filters-toggle button {
  color: var(--blue);
  font-weight: 800;
  padding: 4px 10px;
}
.filters {
  display: none;
  background: var(--white);
  border-radius: var(--radius);
  padding: 14px;
  border: 1.5px solid var(--border);
  margin-bottom: 14px;
}
.filters.open { display: block; }
.filter-group { margin-bottom: 14px; }
.filter-group:last-child { margin-bottom: 0; }
.filter-group label {
  display: block;
  font-weight: 700;
  color: var(--dark);
  margin-bottom: 6px;
  font-size: 0.88rem;
}
.chip-row { display: flex; flex-wrap: wrap; gap: 6px; }
.chip {
  padding: 7px 12px;
  border-radius: 20px;
  background: var(--bg-soft);
  color: var(--dark);
  font-size: 0.82rem;
  font-weight: 600;
  border: 1.5px solid transparent;
  transition: all .15s;
}
.chip.active {
  background: var(--blue);
  color: var(--white);
  border-color: var(--blue);
}
</style>
</head>
